@@ -17,6 +17,46 @@ import torch
 from vllm_ascend.dflash_config import DFlashCalibrationConfig as FeedbackConfig
 
 
+def validate_feedback_runtime(vllm_config, speculator, expected_type):
+    """Report every incompatible setting instead of a misleading catch-all."""
+    errors = []
+    if type(speculator) is not expected_type:
+        actual = f"{type(speculator).__module__}.{type(speculator).__qualname__}"
+        errors.append(f"speculator={actual} (required: plain {expected_type.__name__}; variants are unsupported)")
+
+    def require(path, actual, expected):
+        if actual != expected:
+            errors.append(f"{path}={actual!r} (required: {expected!r})")
+
+    require("model_config.enforce_eager", vllm_config.model_config.enforce_eager, True)
+    require("speculative_config.enforce_eager", speculator.speculative_config.enforce_eager, True)
+    # None is unresolved/default, not an explicit async enablement. The prior
+    # guard also rejected only truthy values; retain that behavior here.
+    if vllm_config.scheduler_config.async_scheduling:
+        require("scheduler_config.async_scheduling", vllm_config.scheduler_config.async_scheduling, False)
+    for field in (
+        "tensor_parallel_size",
+        "pipeline_parallel_size",
+        "data_parallel_size",
+        "prefill_context_parallel_size",
+        "decode_context_parallel_size",
+    ):
+        require(f"parallel_config.{field}", getattr(vllm_config.parallel_config, field, 1), 1)
+    require("speculative_config.draft_sample_method", speculator.speculative_config.draft_sample_method, "greedy")
+    require(
+        "speculative_config.rejection_sample_method", speculator.speculative_config.rejection_sample_method, "standard"
+    )
+    require("speculative_config.enable_adaptive_verification", speculator.enable_adaptive_verification, False)
+    require("speculative_config.use_local_argmax_reduction", speculator.use_local_argmax_reduction, False)
+    if getattr(vllm_config, "watermark_config", None) is not None:
+        errors.append("watermark_config is configured (required: None)")
+    target_vocab = vllm_config.model_config.get_vocab_size()
+    if target_vocab != speculator.vocab_size:
+        errors.append(f"vocab_size: target={target_vocab}, draft={speculator.vocab_size} (required: identical)")
+    if errors:
+        raise ValueError("Unsupported DFlash feedback configuration:\n  - " + "\n  - ".join(errors))
+
+
 class FeedbackCalibrator:
     def __init__(self, config: FeedbackConfig):
         self.config = config
